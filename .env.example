# SPLAT 04 environment
# Copy to .env for local overrides. All values have working defaults.

# Port the Node game server listens on (HTTP + WebSocket share this port).
PORT=8787

# Host interface to bind. Use 0.0.0.0 to test from a phone on your LAN.
HOST=0.0.0.0

# Public origin used when generating crew / challenge share links.
# Leave unset to derive from the incoming request.
PUBLIC_ORIGIN=

# Where the production server looks for the built web client.
# Defaults to ../../web/dist relative to the compiled server entrypoint.
WEB_DIST=

# Server simulation rate (Hz). 20 is the tuned default.
TICK_RATE=20

# Snapshot broadcast rate (Hz). 10 is the tuned default.
SNAPSHOT_RATE=10
